# Template only. Copy to .env.local after the application exists.
# Public values; visible to browsers.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets. Never use NEXT_PUBLIC_ for these.
SUPABASE_SECRET_KEY=
GEMINI_API_KEY=
# Choose an available stable model supporting structured outputs at setup time.
GEMINI_MODEL=
TELEGRAM_BOT_TOKEN=
CRON_SECRET=
QUOTE_SIGNING_SECRET=
RATE_LIMIT_SALT=

# local | demo | production; no security bypasses based on this value.
APP_ENV=local
# Telegram chat_id and non-secret store settings are stored in protected DB settings.
